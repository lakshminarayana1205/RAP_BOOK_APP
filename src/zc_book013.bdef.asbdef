projection implementation in class ZBP_C_BOOK012 unique;
strict ( 2 );
extensible;
use draft;
use side effects;
define behavior for ZC_BOOK013 alias Book
extensible
use etag
{
  use create;
  use update;
  use delete;

  field ( readonly )
  BookID;
  use action getRecommendations;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Author { create; with draft; }
  use association _Inventory { create; with draft; }

}

define behavior for ZC_AUTHOR alias Author
extensible
use etag
{
  use update;
  use delete;

  use association _Book { with draft; }

}

define behavior for ZC_INVENTORY alias Inventory
extensible
use etag
{
  use update;
  use delete;

  use association _Book { with draft; }

}